# RainbowKit Wallet Configuration
NEXT_PUBLIC_WC_PROJECT_ID=id

# Upstash KV Storage
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# NextAuth Configuration
# NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL=https://xyz123.ngrok-free.app
NEXTAUTH_SECRET=your_secret_here  # Generate with: openssl rand -base64 32

# Self Protocol Human Verification (Optional - for advanced identity verification)
NEXT_PUBLIC_SELF_SCOPE=sendhaven                    # Scope name for Self Protocol (max 10 chars)
NEXT_PUBLIC_SELF_APP_NAME="SendHaven"        # Display name in Self app
NEXT_PUBLIC_SELF_ENDPOINT=https://xyz123.ngrok-free.app/api/self/verify  # Verification endpoint (ngrok for testing)
NEXT_PUBLIC_SELF_RPC=https://forno.celo.org       # RPC endpoint for Self Protocol

################################
# Chain Configuration
# SendHaven only supports Arc Testnet for escrow contracts.
# Users can bridge USDC from other testnets (Sepolia, Base Sepolia, Arbitrum Sepolia) to Arc.

# Local deployment (Hardhat)
# NEXT_PUBLIC_CHAIN=hardhat
# NEXT_PUBLIC_MASTER_FACTORY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512  # Update after deploying
# NEXT_PUBLIC_USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3          # Update after deploying MockUSDC
# NEXT_PUBLIC_CHAIN_ID=31337                                                   # Hardhat local
# ADMIN_WALLET_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266              # Hardhat first account

# Contract Deployment Addresses
# Arc Testnet is the only supported chain for escrow contracts
# Note: USDC address on Arc is 0x3600000000000000000000000000000000000000 (native ERC-20)

# Arc Testnet (Chain ID: 5042002) - Required for escrow functionality
NEXT_PUBLIC_MASTER_FACTORY_ADDRESS_ARC=0xYourArcTestnetFactoryAddress          # Deployed MasterFactory on Arc Testnet

# Hardhat Local (optional - for development only)
# NEXT_PUBLIC_MASTER_FACTORY_ADDRESS_HARDHAT=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# NEXT_PUBLIC_USDC_ADDRESS_HARDHAT=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Admin Configuration
ADMIN_WALLET_ADDRESS=0xYourAdminWalletAddress                                    # Server-side admin arbiter wallet address (REQUIRED for API authorization)

